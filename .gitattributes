# Normalise line endings. Without this, a Windows clone with core.autocrlf=true
# checks the tree out as CRLF while Prettier expects LF, and `pnpm format:check`
# fails on every file in the repo.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.blend binary
