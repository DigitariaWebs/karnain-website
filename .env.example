# Karnain — environment variables.
# Copy to `.env.local` and fill in. Leave Supabase blank to run on the in-code seed catalog
# (the site works with zero configuration); fill it to read from Supabase and enable admin.

# Supabase (public — sent to the browser). The publishable key is safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used by checkout/webhook to write orders (bypasses RLS) — never expose.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (checkout + orders). Optional here — these can instead be set from the admin at
# /admin/parametres (stored server-side, read via the service role). Env is the fallback.
# Leave everything blank to keep the bag in “paiement bientôt” mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
