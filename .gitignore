# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# production
/build

# testing
/coverage

# playwright
/test-results/
/playwright-report/
/blob-report/
/.playwright-mcp/
/playwright/.cache/

# generated artifacts (screenshots, traces, reference captures)
/artifacts/

# 3D working directory: Blender exports, test renders, one-off scripts. Anything the site
# actually serves is copied into public/ — this is the cutting-room floor.
/scratch/

# env files (never commit secrets; .env.example is tracked)
.env
.env.*
!.env.example

# raw asset archives (extract into public/, don't commit the zip itself)
/public/*.zip

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
.idea/
.vscode/*
!.vscode/extensions.json

# 3D source project (blend, frames) — only the exported web assets in public/ are committed
/3d-showcase/
